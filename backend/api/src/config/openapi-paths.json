{
  "/v1/auth/nonce": {
    "get": {
      "summary": "Reject nonce reads and direct clients to the POST challenge flow",
      "tags": ["Auth"],
      "responses": {
        "405": {
          "description": "Method not allowed"
        }
      }
    },
    "post": {
      "summary": "Create a wallet login challenge nonce",
      "tags": ["Auth"],
      "responses": {
        "200": {
          "description": "Login challenge"
        },
        "400": {
          "description": "Invalid wallet address"
        }
      }
    }
  },
  "/v1/auth/login": {
    "post": {
      "summary": "Verify a wallet signature and issue access credentials",
      "tags": ["Auth"],
      "responses": {
        "200": {
          "description": "Access token response"
        },
        "401": {
          "description": "Invalid challenge or signature"
        }
      }
    }
  },
  "/v1/auth/refresh": {
    "post": {
      "summary": "Rotate a refresh token and issue a new access token",
      "tags": ["Auth"],
      "responses": {
        "200": {
          "description": "Rotated access token response"
        },
        "401": {
          "description": "Invalid refresh token"
        }
      }
    }
  },
  "/v1/auth/logout": {
    "post": {
      "summary": "Revoke the current refresh token",
      "tags": ["Auth"],
      "responses": {
        "204": {
          "description": "Refresh token revoked"
        },
        "401": {
          "description": "Invalid refresh token"
        }
      }
    }
  },
  "/v1/auth/sessions/{address}": {
    "get": {
      "summary": "List active refresh sessions for a wallet",
      "tags": ["Auth"],
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Refresh session list"
        },
        "403": {
          "description": "Operator or admin role required"
        }
      }
    }
  },
  "/v1/auth/sessions/{address}/revoke": {
    "post": {
      "summary": "Revoke all refresh sessions for a wallet",
      "tags": ["Auth"],
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Revocation result"
        },
        "403": {
          "description": "Operator or admin role required"
        }
      }
    }
  },
