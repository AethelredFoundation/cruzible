#!/bin/sh
# Pre-commit hook for Cruzible
# Runs linting and tests before allowing commits

STASH_CREATED=0

restore_stash() {
    if [ "$STASH_CREATED" -eq 1 ]; then
        git stash pop -q
    fi
}

trap restore_stash EXIT

echo "Running pre-commit checks..."

# Stash tracked unstaged changes without touching an existing stash stack.
if ! git diff --quiet; then
    git stash push -q --keep-index -m "cruzible-pre-commit-unstaged"
    STASH_CREATED=1
fi

# Run linting
echo "Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
    echo "ESLint failed. Fix errors before committing."
    exit 1
fi

# Run formatting check
echo "Checking formatting..."
npm run format:check
if [ $? -ne 0 ]; then
    echo "Formatting check failed. Run 'npm run format' to fix."
    exit 1
fi

# Run type checking
echo "Running TypeScript check..."
npm run type-check
if [ $? -ne 0 ]; then
    echo "TypeScript check failed. Fix type errors before committing."
    exit 1
fi

# Run unit tests (only affected files)
echo "Running unit tests..."
npm run test:changed
if [ $? -ne 0 ]; then
    echo "Unit tests failed. Fix tests before committing."
    exit 1
fi

echo "All pre-commit checks passed!"
exit 0
