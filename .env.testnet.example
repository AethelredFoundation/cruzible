# Cruzible backend — single-box testnet bring-up (docker compose).
#
#   cp .env.testnet.example .env
#   docker compose up --build            # Postgres + Redis + migrations + API on :4001
#   docker compose --profile indexer up --build   # additionally run the chain indexer
#
# Why this file lives at the REPO ROOT even though the backend is in
# backend/api: the API image builds from the repo root (its Dockerfile copies
# backend/api/ AND sdk/typescript/), so docker-compose.yml sits here, and
# compose reads the .env next to itself. The backend process never reads any
# .env file directly — it receives its environment from compose (env_file).
# Running the API bare (npm run dev in backend/api) therefore requires
# exporting these variables in your shell instead.
#
# DATABASE_URL and REDIS_URL are injected by docker-compose (compose-internal
# services) — do not set them here for the compose path.

# ── runtime profile ─────────────────────────────────────────────────────────
# development = bring-up profile. Setting NODE_ENV=production additionally
# enforces: real 32+ character JWT_SECRET / JWT_REFRESH_SECRET /
# LOG_HASH_SECRET (dev defaults are refused) and a TLS Redis (rediss://).
# See backend/api/src/config/index.ts for the full hardened contract.
NODE_ENV=development
CRUZIBLE_NETWORK=testnet

# Host port the API is published on (the container listens on 4001).
CRUZIBLE_API_PORT=4001

# ── chain endpoints ─────────────────────────────────────────────────────────
# IMPORTANT: these are resolved FROM INSIDE the API container. `localhost` /
# `127.0.0.1` there means the container itself, never the VPS. If the
# aethelredd node runs on the same machine, use `host.docker.internal`
# (docker-compose maps it to the host on Linux via host-gateway); otherwise
# use the node machine's reachable IP/hostname. The API fails fast at boot if
# RPC_URL is unreachable — that is the most common cause of an api container
# exiting right after `docker compose up`.
#
# RPC_URL is the COSMOS (CometBFT) RPC of your Aethelred node — port 26657.
RPC_URL=http://host.docker.internal:26657

# INDEXER_RPC_URL is the EVM JSON-RPC — port 8545. Used for vault reads,
# protocol-epoch estimation, and the indexer. INDEXER_WS_URL is optional.
INDEXER_RPC_URL=http://host.docker.internal:8545
#INDEXER_WS_URL=ws://host.docker.internal:8546

# Refuse to index a chain other than the Aethelred testnet.
INDEXER_EXPECTED_CHAIN_ID=7332
# Immutable EVM block-1 anchor for the current public testnet.
INDEXER_EXPECTED_GENESIS_HASH=0xf4b43647f4d3255a7e9321ea4b32057101ed143623390bc30d59e69a91ceafa7

# Live vault-event indexing subscribes over EVM WebSocket and requires BOTH:
# the node started with --json-rpc.ws-address (port 8546) AND INDEXER_WS_URL
# set above. Defaults to false because with it enabled and no reachable WS
# endpoint the API exits at boot. The API is fully functional for reads over
# HTTP RPC with this off — only live event indexing and reconciliation
# freshness are deferred. Flip to true once the WS endpoint exists.
INDEXER_ENABLED=false

# ── deployed contracts (paste from your deploy output) ──────────────────────
CRUZIBLE_VAULT_ADDRESS=
STAETHEL_ADDRESS=
#STABLECOIN_BRIDGE_ADDRESS=

# Start indexing at your deployment block instead of genesis.
INDEXER_START_BLOCK=0

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated, exact origins the frontend is served from — e.g.
#   CORS_ORIGINS=http://localhost:3000,http://<frontend-host>:3000
# Wildcards (*) are REFUSED at boot by the hardened config; an entry like
# CORS_ORIGINS=* exits the api container immediately.
CORS_ORIGINS=http://localhost:3000

# ── operational endpoints ───────────────────────────────────────────────────
# The shared testnet profile protects operational endpoints. Generate an
# independent 32+ character value; never copy it into Git.
ALLOW_UNAUTHENTICATED_OPERATIONAL_ENDPOINTS=false
OPERATIONAL_ENDPOINTS_TOKEN=

# ── secrets (set even in a shared development-profile testnet) ─────────────
# Generate independent 32+ character values. They become mandatory when
# NODE_ENV=production and must never be committed.
JWT_SECRET=
JWT_REFRESH_SECRET=
LOG_HASH_SECRET=

# Comma-separated approved aeth1 operator/admin wallets. Production requires
# at least one of these lists; shared testnet operators should set them too.
AUTH_OPERATOR_ADDRESSES=
AUTH_ADMIN_ADDRESSES=
