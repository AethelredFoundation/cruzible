# ═══════════════════════════════════════════════════════════════
# Cruzible — frontend configuration (accurate var names, matches the code)
# ═══════════════════════════════════════════════════════════════
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* vars are inlined at BUILD
# time — set them BEFORE `npm run build` (and restart `npm run dev`).

# ── Network ────────────────────────────────────────────────────
# mainnet | testnet | devnet. REQUIRED in production builds.
# testnet and devnet are the SAME chain id (7332) via different endpoints.
NEXT_PUBLIC_CHAIN_ENV=testnet

# EVM JSON-RPC overrides (read by src/config/chains.ts). Point testnet at a
# validator's public IP (the *.aethelred.network domains are not deployed);
# point devnet at your local `aethelredd start --json-rpc.enable` node.
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=http://54.165.44.130:8545
#NEXT_PUBLIC_AETHELRED_DEVNET_RPC_URL=http://127.0.0.1:8545

# ── Core contracts (from scripts/deploy-contracts.mjs output) ──
# The deploy script prints these two lines ready to paste — see
# docs/TESTNET_DEPLOYMENT.md for the full setup guide. AETHEL is the
# NATIVE coin on Aethelred — there is NO AETHEL token address on this chain
# (leave NEXT_PUBLIC_AETHEL_TOKEN_ADDRESS unset; it exists only for chains
# with a bridged ERC-20 AETHEL).
NEXT_PUBLIC_CRUZIBLE_ADDRESS=
NEXT_PUBLIC_STAETHEL_ADDRESS=

# ── Optional ───────────────────────────────────────────────────
# Backend control-plane API (reconciliation/validator-intelligence panels).
# The vault UI works without it; those panels show "not yet available".
#NEXT_PUBLIC_API_URL=http://localhost:3001

# ZeroID app URL — shown as the "register" link when the vault's identity
# gate is on and the connected wallet has no active ZeroID identity.
#NEXT_PUBLIC_ZEROID_APP_URL=http://localhost:3000

# Governance / stablecoin-bridge surfaces (leave unset unless deployed):
#NEXT_PUBLIC_GOVERNANCE_ADDRESS=
#NEXT_PUBLIC_STABLECOIN_BRIDGE_ADDRESS=
#NEXT_PUBLIC_USDC_TOKEN_ADDRESS=
#NEXT_PUBLIC_USDT_TOKEN_ADDRESS=

# WalletConnect (optional; the injected connector needs no project id):
#NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
