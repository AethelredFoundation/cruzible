# ═══════════════════════════════════════════════════════════════
# Cruzible — frontend configuration (accurate var names, matches the code)
# ═══════════════════════════════════════════════════════════════
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* vars are inlined at BUILD
# time — set them BEFORE `npm run build` (and restart `npm run dev`).

# ── Network ────────────────────────────────────────────────────
# mainnet | testnet | devnet. REQUIRED in production builds.
# testnet and devnet are the SAME chain id (7332) via different endpoints.
NEXT_PUBLIC_CHAIN_ENV=testnet
# Exact canonical EVM genesis anchor hash (block 1) for the selected
# RPC/network. Required in production because testnet and devnet currently
# share EIP-155 chain id 7332. This checked-in value is the public testnet
# anchor returned by http://54.165.44.130:8545 on 2026-07-22; replace it when
# selecting devnet or after an explicitly coordinated testnet genesis reset.
NEXT_PUBLIC_AETHELRED_GENESIS_HASH=0xf4b43647f4d3255a7e9321ea4b32057101ed143623390bc30d59e69a91ceafa7

# EVM JSON-RPC endpoints (read by src/config/chains.ts). Testnet builds require
# an operator-supplied endpoint; there is deliberately no hosted DNS fallback.
# Plain HTTP is allowed only with CRUZIBLE_ALLOW_PLAINTEXT_HTTP=true during a
# documented pre-TLS testnet phase. Never place RPC credentials in public vars.
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=
#NEXT_PUBLIC_AETHELRED_TESTNET_EXPLORER_URL=
#NEXT_PUBLIC_AETHELRED_DEVNET_RPC_URL=http://127.0.0.1:8545

# Mainnet is not configured in this repository. Once the network is formally
# confirmed, all three values are required for a mainnet build:
#NEXT_PUBLIC_AETHELRED_MAINNET_CHAIN_ID=
#NEXT_PUBLIC_AETHELRED_MAINNET_RPC_URL=
#NEXT_PUBLIC_AETHELRED_MAINNET_EXPLORER_URL=

# ── Core contracts (from scripts/deploy-contracts.mjs output) ──
# The deploy script prints these two lines ready to paste — see
# docs/TESTNET_DEPLOYMENT.md for the full setup guide. AETHEL is the
# NATIVE coin on Aethelred — there is NO AETHEL token address on this chain
# (leave NEXT_PUBLIC_AETHEL_TOKEN_ADDRESS unset; it exists only for chains
# with a bridged ERC-20 AETHEL).
NEXT_PUBLIC_CRUZIBLE_ADDRESS=
NEXT_PUBLIC_STAETHEL_ADDRESS=

# ── Complete deployed build inputs ─────────────────────────────
# Required by `npm run build` and production images. It can be omitted only
# while using `npm run dev` for local contract-only vault development; API
# panels then fail closed as unavailable.
NEXT_PUBLIC_API_URL=

# Required for complete testnet/mainnet wallet coverage. It may be omitted
# only for injected-wallet-only local development.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ZeroID app URL — shown as the "register" link when the vault's identity
# gate is on and the connected wallet has no active ZeroID identity.
#NEXT_PUBLIC_ZEROID_APP_URL=http://localhost:3000
#NEXT_PUBLIC_APP_VERSION=local-dev

# Governance / stablecoin-bridge surfaces (leave unset unless deployed):
#NEXT_PUBLIC_GOVERNANCE_ADDRESS=
#NEXT_PUBLIC_STABLECOIN_BRIDGE_ADDRESS=
#NEXT_PUBLIC_USDC_TOKEN_ADDRESS=
#NEXT_PUBLIC_USDT_TOKEN_ADDRESS=
